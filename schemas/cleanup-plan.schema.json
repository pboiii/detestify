{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://test-steward.dev/schemas/cleanup-plan.schema.json",
  "title": "Cleanup plan",
  "description": "Read-only candidate plan for legacy test portfolio cleanup.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "generated_at",
    "repository",
    "candidates",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "description": "Cleanup plan schema version.",
      "const": "1.0"
    },
    "plan_id": {
      "description": "Unique plan identifier.",
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "description": "RFC 3339 generation time.",
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "description": "Repository snapshot analyzed by the plan.",
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "revision", "diff_fingerprint"],
      "properties": {
        "root": {
          "description": "Canonical absolute repository root.",
          "type": "string",
          "pattern": "^/"
        },
        "revision": {
          "description": "Git revision used for stable analysis.",
          "type": "string",
          "minLength": 1
        },
        "diff_fingerprint": {
          "description": "Digest of any worktree diff included in analysis.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidates": {
      "description": "Ranked cleanup candidates.",
      "type": "array",
      "items": {
        "description": "One test ownership or placement candidate.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "test_paths",
          "action",
          "obligation_ids",
          "structural_signals",
          "independent_signals",
          "protected_checks",
          "counterfactual",
          "worktree_validation",
          "human_approval",
          "rationale",
          "limitations"
        ],
        "properties": {
          "id": {
            "description": "Stable plan-local candidate identifier.",
            "type": "string",
            "minLength": 1
          },
          "test_paths": {
            "description": "Repository-relative paths included in the candidate.",
            "type": "array",
            "items": {
              "description": "Test path.",
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "action": {
            "description": "Conservative alpha cleanup action.",
            "enum": [
              "KEEP",
              "MERGE_CANDIDATE",
              "DELETE_CANDIDATE",
              "MOVE_CANDIDATE",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "obligation_ids": {
            "description": "Declared or candidate obligations associated with the tests.",
            "type": "array",
            "items": {
              "description": "Obligation identifier.",
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "structural_signals": {
            "description": "Static or structural redundancy signals.",
            "type": "array",
            "items": {
              "description": "Evidence identifier for a structural signal.",
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "independent_signals": {
            "description": "Behavioral or historical signals independent of structural similarity.",
            "type": "array",
            "items": {
              "description": "Evidence identifier for an independent signal.",
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "protected_checks": {
            "description": "Results of checking durable protected-test and obligation records.",
            "type": "array",
            "items": {
              "description": "One protection check.",
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "passed", "detail"],
              "properties": {
                "source": {
                  "description": "Protected record or policy source checked.",
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "description": "True when this source does not block the candidate.",
                  "type": "boolean"
                },
                "detail": {
                  "description": "Human-readable check result.",
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "minItems": 1
          },
          "counterfactual": {
            "description": "Proposed or observed removal/merge validation.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "commands_ref",
              "preserved_obligations",
              "limitations"
            ],
            "properties": {
              "status": {
                "description": "Whether counterfactual validation was run.",
                "enum": ["not_run", "passed", "failed", "partial"]
              },
              "commands_ref": {
                "description": "Reference to commands and environment, or null.",
                "type": ["string", "null"]
              },
              "preserved_obligations": {
                "description": "Obligations demonstrated preserved by the counterfactual.",
                "type": "array",
                "items": {
                  "description": "Obligation identifier.",
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "limitations": {
                "description": "Counterfactual limitations.",
                "type": "array",
                "items": {
                  "description": "A limitation.",
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "worktree_validation": {
            "description": "Isolated worktree validation record.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "worktree_ref",
              "revision",
              "cleanup_complete"
            ],
            "properties": {
              "status": {
                "description": "Validation status.",
                "enum": ["not_run", "passed", "failed", "partial"]
              },
              "worktree_ref": {
                "description": "Opaque worktree/run reference, or null.",
                "type": ["string", "null"]
              },
              "revision": {
                "description": "Revision validated, or null.",
                "type": ["string", "null"]
              },
              "cleanup_complete": {
                "description": "Whether the temporary worktree and child processes were cleaned up.",
                "type": "boolean"
              }
            }
          },
          "human_approval": {
            "description": "Human review requirement and status.",
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "status", "approver_ref"],
            "properties": {
              "required": {
                "description": "Whether approval is required before destructive action.",
                "type": "boolean"
              },
              "status": {
                "description": "Approval state.",
                "enum": ["not_requested", "pending", "approved", "rejected"]
              },
              "approver_ref": {
                "description": "Opaque approver/audit reference, or null.",
                "type": ["string", "null"]
              }
            }
          },
          "rationale": {
            "description": "Why the candidate received this action.",
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "description": "Candidate-specific limitations.",
            "type": "array",
            "items": {
              "description": "A limitation.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "DELETE_CANDIDATE",
                  "description": "Conditional selector for action."
                }
              }
            },
            "then": {
              "properties": {
                "structural_signals": {
                  "minItems": 1,
                  "description": "Conditional constraint for structural_signals."
                },
                "independent_signals": {
                  "minItems": 1,
                  "description": "Conditional constraint for independent_signals."
                },
                "protected_checks": {
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "passed": {
                        "const": true,
                        "description": "Conditional constraint for passed."
                      }
                    },
                    "required": ["passed"],
                    "description": "Conditional item constraint for protected_checks."
                  },
                  "description": "Conditional constraint for protected_checks."
                },
                "human_approval": {
                  "properties": {
                    "required": {
                      "const": true,
                      "description": "Conditional constraint for required."
                    }
                  },
                  "description": "Conditional constraint for human_approval."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": ["MERGE_CANDIDATE", "INSUFFICIENT_EVIDENCE"],
                  "description": "Conditional selector for action."
                }
              }
            },
            "then": {}
          }
        ]
      }
    },
    "limitations": {
      "description": "Plan-level limitations.",
      "type": "array",
      "items": {
        "description": "A limitation.",
        "type": "string",
        "minLength": 1
      }
    }
  }
}

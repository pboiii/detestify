{
  "name": "detestify",
  "version": "0.1.0-alpha.0",
  "description": "Evidence-backed test portfolio policy CLI for coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pboiii/detestify.git"
  },
  "bugs": {
    "url": "https://github.com/pboiii/detestify/issues"
  },
  "homepage": "https://github.com/pboiii/detestify#readme",
  "keywords": [
    "testing",
    "code-agents",
    "claude-code",
    "codex",
    "test-maintenance"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "detestify": "./dist/bin/detestify.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    ".agents",
    ".claude-plugin",
    "dist/bin",
    "dist/src",
    "dist/schemas",
    "plugins",
    "skills",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run build --silent && eslint dist/src dist/bin scripts/*.mjs eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:spec": "tsx scripts/validate-spec.ts",
    "test": "vitest run",
    "test:schemas": "vitest run test/unit/schemas.test.ts",
    "test:unit": "vitest run test/unit",
    "test:policy-goldens": "vitest run test/policy-goldens --passWithNoTests",
    "test:fixture-cli": "vitest run test/fixture-cli --passWithNoTests",
    "test:hook-normalization": "vitest run test/hook-contracts/normalization.test.ts --passWithNoTests",
    "test:hook-contracts": "vitest run test/hook-contracts --passWithNoTests",
    "test:cleanup-safety": "vitest run test/cleanup-safety test/unit/cleanup-planner test/unit/cleanup-detectors --passWithNoTests",
    "test:security": "vitest run test/security --passWithNoTests",
    "test:pr": "npm run typecheck && npm run lint && npm run format:check && npm run validate:spec && npm run test:schemas && npm run test:unit && npm run test:policy-goldens && npm run test:hook-contracts && npm run test:cleanup-safety && npm run test:security && npm run test:fixtures && npm run test:fixture-cli",
    "benchmark:canary": "tsx scripts/run-canary.ts",
    "test:fixtures": "vitest run test/fixtures --passWithNoTests"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "14.0.2",
    "ts-morph": "27.0.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "esbuild": "0.25.12",
    "eslint": "10.2.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
